--!strict
-- UpgradeFlavor: each business's own names for the shared upgrades, so a hotel builds
-- guest rooms and hires housekeepers while a pizzeria builds brick ovens and hires
-- pizzaiolos. The numbers stay in Businesses.Upgrades (one stat model for every
-- business); this only changes what the player reads.
-- Entry: { name, flavour sentence, emoji, tier names? }. The effect ("+35% production.")
-- is added from the shared upgrade, so it always matches the real maths.
-- `Dining` renames the capacity tab (Seating) for that business.
-- Container: ReplicatedStorage.Shared

export type Entry = { any }

local function statue(who: string, fountain: string?): Entry
	return { "Centerpiece", "A show-stopping centerpiece everyone photographs.", "💎", { "None", "Golden " .. who .. " Statue", fountain or "Grand Fountain" } }
end

